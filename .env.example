# KISAN MITRA edge server environment variables.
# Copy this file to `.env` (or export the values) before starting edge_server.py.
# Values in `.env` are loaded automatically by python-dotenv.

# REQUIRED in production: any long random string. Used to sign sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
KISAN_SECRET_KEY=replace-with-a-random-secret

# OPTIONAL: when set, all write endpoints (POST /api/sensors, /api/disease,
# /api/profile) require an "Authorization: Bearer <token>" header. Recommended
# whenever the Pi is reachable beyond a trusted farm LAN.
KISAN_API_TOKEN=

# OPTIONAL OpenWeatherMap current-weather integration (free tier). When a key
# is set, temperature/humidity/rainfall shown in the dashboard come from live
# conditions. The weather location is resolved in this order: GPS from the
# Arduino's telemetry, then the farm location saved on the dashboard (Advanced
# view -> Farm location), then OPENWEATHER_CITY below. If the request fails
# (offline, revoked key, rate limit) the app falls back to local sensor
# readings, so the farm keeps working with no internet.
# Get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Delhi

# Port the dashboard and API listen on.
PORT=3000

# Set to 1 only during local development; never in production.
FLASK_DEBUG=0